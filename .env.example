# Agent env vars (copy to .env and fill in)
OPENROUTER_KEY=sk-or-v1-your-key-here

# Email (IMAP + SMTP)
EMAIL_USER=bot@uff.email
EMAIL_PASSWORD=your-password
EMAIL_IMAP_HOST=mail.worotyns.ovh
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=mail.worotyns.ovh
EMAIL_SMTP_PORT=465

# Cloudflare Browser Run (opcjonalne – do browser_screenshot / browser_markdown)
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token

# User details
USER_LANGUAGE=pl
USER_TIMEZONE=Europe/Warsaw

# Override modeli (wymagane)
AGENTS=assistant,researcher,sources
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
VISION_MODEL=google/gemini-3.1-flash-lite
IMAGE_GEN_MODEL=google/gemini-3.1-flash-lite-image
TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
TTS_VOICE=nova
ASSISTANT_MODEL=deepseek/deepseek-v4.1-flash
RESEARCHER_MODEL=deepseek/deepseek-v4-pro

# Scheduler (optional)
HEARTBEAT_INTERVAL=300
DREAM_HOUR=03:00

# MCP (Model Context Protocol) — remote tool servers added per-user via email
MCP_ENABLED=true

# Send a first-launch email on startup (also an SMTP smoke test).
WELCOME_EMAIL=true

# Operator alerts (e.g. OpenRouter credit limit). Empty = log only.
ADMIN_NOTIFY_EMAIL=admin@uff.email
